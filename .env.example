# ── Operación ────────────────────────────────────────────────
FASE=propuestas                 # propuestas (todo con SÍ/NO) | auto_simple (autoenvía solo precio/stock verificados)
CANALES=whatsapp,instagram
CADA_MINUTOS=10
HORA_CIERRE=20:00
MAX_RECORDATORIOS=2
TZ_NEGOCIO=America/Argentina/Buenos_Aires

# ── ARTEMIS (github.com/google/artemis) ───────────────────────
# Copiá command/args/cwd del snippet de: uv run artemis mcp --generate-config claude
ARTEMIS_CMD=/ruta/a/artemis/.venv/bin/python
ARTEMIS_ARGS=-m mcp_server
ARTEMIS_CWD=/ruta/a/artemis

# ── Google Sheets (sin SHEETS_ID usa data/local-db.json) ──────
SHEETS_ID=
GOOGLE_CREDENCIALES=credenciales/cuenta-servicio.json

# ── Mercado Pago (sin token, links simulados) ─────────────────
MP_ACCESS_TOKEN=
MP_NOTIFICATION_URL=

# ── LLM compatible con OpenAI (sin key, interpreta con reglas) ─
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODELO=deepseek/deepseek-chat   # revisá el nombre exacto en openrouter.ai/models
LLM_TOPE_DIARIO=300
LLM_HUMANIZAR=0                     # 1 = reescribe la plantilla y la pasa por el verificador
